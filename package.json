{
	"name": "agent-skill-deploy",
	"version": "0.1.5",
	"description": "Mirror deployable vault folders to a canonical GitHub repository",
	"main": "main.js",
	"packageManager": "pnpm@10.32.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:build": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"release:check": "node scripts/validate-release-metadata.mjs",
		"test": "vitest run",
		"ci": "pnpm run build && pnpm run lint && pnpm run test",
		"prepare": "husky",
		"version": "node scripts/version.mjs",
		"postversion": "git push && git push --tags",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix"
		],
		"scripts/**/*.{js,mjs}": [
			"eslint --fix"
		]
	},
	"keywords": [],
	"author": "Beomsu Koh",
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "10.0.1",
		"@types/node": "^26.6.5",
		"builtin-modules": "5.4.0",
		"esbuild": "0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.13.0",
		"husky": "^9.1.7",
		"jiti": "2.7.0",
		"lint-staged": "^17.6.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
